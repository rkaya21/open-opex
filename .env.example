# Production configuration for docker-compose.prod.yml
# Copy to .env and fill in — never commit the real .env.

# Required
SECRET_KEY=change-me-generate-a-long-random-string
POSTGRES_PASSWORD=change-me-strong-db-password
# Comma-separated. Include every tenant domain (or a wildcard suffix like .opex.example.com)
ALLOWED_HOSTS=.opex.example.com

# Recommended when serving over HTTPS (comma-separated origins)
CSRF_TRUSTED_ORIGINS=https://*.opex.example.com

# Optional
HTTP_PORT=80
GUNICORN_WORKERS=3
# CORS is unnecessary in the default same-origin nginx setup; set only if the
# frontend is served from a different origin
CORS_ALLOWED_ORIGINS=

# RS256 JWT keys (optional — HS256 with SECRET_KEY is used when empty).
# Generate: openssl genrsa -out jwt.key 2048 && openssl rsa -in jwt.key -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# SMTP for warning-notification emails (console backend logs instead when unset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=open-opex <noreply@opex.example.com>
